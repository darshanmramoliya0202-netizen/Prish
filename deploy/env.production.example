# /var/www/prish-overseas/.env.production  (chmod 600, owner opc) — copy and fill on the VM
NODE_ENV=production
NEXT_PUBLIC_SITE_URL=https://www.prishoverseas.com
NEXT_PUBLIC_WHATSAPP=919586616746
NEXT_PUBLIC_UMAMI_SRC=/umami/script.js
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=exports@prishoverseas.com
SMTP_PASS_FILE=/opt/prish-overseas/secrets/exports.pw
INQUIRY_TO=exports@prishoverseas.com
INQUIRY_CC=prishoverseas9@gmail.com
INQUIRY_FROM="Prish Overseas <exports@prishoverseas.com>"

LEADS_DIR=/var/www/prish-overseas/data/leads
CRM_ENABLED=true
CRM_DIR=/opt/prish-overseas/mailcrm
CRM_PYTHON=/opt/prish-overseas/mailcrm/.venv/bin/python
CRM_DROP_DIR=/opt/prish-overseas/leads-to-import/website

RATE_LIMIT_PER_10MIN=5
RATE_LIMIT_PER_DAY=20
